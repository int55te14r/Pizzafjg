 <Window x:Class="pizzaShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pizzaShop"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>    
            

        <TextBlock Text="ПИЦЦЕРИЯ"
                   Grid.ColumnSpan="2"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0 10"/>

        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Header="1. Выберите пиццу"
                  Margin="0 5">
            <StackPanel Margin="10">
                <RadioButton x:Name="MargaritaRbtn"
                             Content="Маргарита - 450 руб."
                             IsChecked="True"
                             Click="AnyParameter_Changed"/>
                <RadioButton x:Name="PepperoniRbtn"
                             Content="Пепперони -- 550 руб."
                             Click="AnyParameter_Changed"/>
                <RadioButton x:Name="HawaiiRbtn"
                             Content="Гавайская - 500 руб."
                             Click="AnyParameter_Changed"/>
            </StackPanel>
        </GroupBox>
        
        <GroupBox Grid.Row="2"
                  Header="2. Количество"
                  Margin="0 5">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="10">
                <Button x:Name="MinusBtn"
                        Content="-"
                        Width="40"
                        Height="35"
                        FontSize="20"
                        Click="MinusBtn_Click"/>
                <TextBox x:Name="QuantityTb"
                         Text="1"
                         Width="60"
                         Height="35"
                         TextAlignment="Center"
                         FontSize="16"
                         IsReadOnly="True"/>
                <Button x:Name="PlusBtn"
                        Content="+"
                        Width="40"
                        Height="35"
                        FontSize="20"
                        Click="PlusBtn_Click"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3"
                  Header="3. Напиток"
                  Margin="0 5">
            <StackPanel Margin="10">
                <CheckBox x:Name="DrinkChbx"
                          Content="Добавить напиток"
                          Click="DrinkChbx_Click"/>
                <Border Margin="20 5 0 0">
                    <StackPanel x:Name="DrinkPanel"
                                IsEnabled="False">
                        <RadioButton x:Name="ColaRbtn"
                             Content="Кола - 100 руб."
                             Click="AnyParameter_Changed"/>
                        <RadioButton x:Name="JuiceRbtn"
                             Content="Сок - 80 руб."
                             Click="AnyParameter_Changed"/>
                        <RadioButton x:Name="WaterRbtn"
                             Content="Вода - 50 руб."
                                    IsChecked="True"
                             Click="AnyParameter_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Grid.Column="1"
          Header="5. Промокод"
          Margin="0 5">
            <StackPanel Margin="10">
                <TextBox x:Name="PromoTb"
                 Width="150"
                 Height="30"
                 TextChanged="AnyParameter_Changed"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Grid.Column="1"
          Header="4. Способ получения"
          Margin="0 5">
            <StackPanel Margin="10">
                <RadioButton x:Name="PickupRbtn"
                     Content="Самовывоз"
                     IsChecked="True"
                     Click="AnyParameter_Changed"/>

                <RadioButton x:Name="DeliveryRbtn"
                     Content="Доставка (+150 руб.)"
                     Click="AnyParameter_Changed"/>
            </StackPanel>
        </GroupBox>
        
        <Border Grid.Row="4"
                Grid.ColumnSpan="2"
                Background="Wheat"
                BorderBrush="Red"
                BorderThickness="2"
                CornerRadius="8"
                Margin="0 20">
            <TextBlock x:Name="TotalTl"
                       Text="ИТОГО: 450 руб."
                       FontSize="20"
                       Foreground="Red"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Padding="15"/>
        </Border>

        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 20">
            <Button x:Name="OrderBtn"
                    Content="Оформить заказ"
                    Width="140"
                    Height="45"
                    Margin="5"
                    FontSize="14"
                    Click="OrderBtn_Click"/>
            <Button x:Name="ReserBtn"
                    Content="Сбросить"
                    Width="100"
                    Height="45"
                    Margin="5"
                    FontSize="14"
                    Click="ReserBtn_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="3"
                  Grid.Column="1"
          Header="6. Дополнительно"
          Margin="0 5">

            <StackPanel Margin="10">

                <CheckBox x:Name="CheeseChbx"
                  Content="Сыр +50 руб."
                  Click="AnyParameter_Changed"/>

                <CheckBox x:Name="BaconChbx"
                  Content="Бекон +70 руб."
                  Click="AnyParameter_Changed"/>

                <CheckBox x:Name="OlivkiChbx"
                  Content="Оливки +100 руб."
                  Click="AnyParameter_Changed"/>

                <CheckBox x:Name="GribChbx"
                  Content="грибочки +5000 руб."
                  Click="AnyParameter_Changed"/>

            </StackPanel>
        </GroupBox>
        
    </Grid>
</Window>